<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- CSS for users with dark mode -->
        <link
            rel="stylesheet"
            href="https://unpkg.com/awsm.css/dist/awsm_theme_big-stone.min.css"
            media="(prefers-color-scheme: dark)"
        >

        <!-- CSS for users without dark mode -->
        <link
            rel="stylesheet"
            href="https://unpkg.com/awsm.css/dist/awsm_theme_pearl-lusta.min.css"
            media="(prefers-color-scheme: no-preference), (prefers-color-scheme: light)"
        >

        <title>Connect with your mobile device</title>
    </head>

    <body>
        <main>
            <article>
                <section>
                    <h4>Connect to room</h4>
                    <h5 id="status"></h5>
                    <h5 id="sensor_status"></h5>
                </section>
            </article>
            <article>
                <section>
                    <h4>Accelerometer Data</h4>
                    <table>
                        <tbody>
                            <tr>
                                <td>x</td>
                                <td id="accelerometer_data_x_raw"></td>
                            </tr>
                            <tr>
                                <td>y</td>
                                <td id="accelerometer_data_y_raw"></td>
                            </tr>
                            <tr>
                                <td>z</td>
                                <td id="accelerometer_data_z_raw"></td>
                            </tr>
                        </tbody>
                    </table>
                </section>
                <section>
                    <h4>Sensor Quaternion Data Adjusted</h4>
                    <table>
                        <tbody>
                            <tr>
                                <td>x</td>
                                <td id="sensor_data_x_adjusted"></td>
                            </tr>
                            <tr>
                                <td>y</td>
                                <td id="sensor_data_y_adjusted"></td>
                            </tr>
                            <tr>
                                <td>z</td>
                                <td id="sensor_data_z_adjusted"></td>
                            </tr>
                            <tr>
                                <td>w</td>
                                <td id="sensor_data_w_adjusted"></td>
                            </tr>
                        </tbody>
                    </table>
                </section>
            </article>
            <article>
                <h4>Set Initial Position</h4>
                <button id="set_initial_position">Set Initial Position</button>
            </article>
        </main>

        <script type="module" src="/connect.js"></script>
    </body>
</html>
